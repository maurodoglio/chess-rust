# Example environment variables for docker-compose
# Copy this file to .env in the project root to customize your deployment

# Backend configuration
# Backend listens on port 3000 by default (see docker-compose.yml)

# Frontend configuration
# Frontend is served on port 80 by default (see docker-compose.yml)
API_URL=http://localhost:3000

# Network configuration
# Docker Compose project name can be set in your own .env if needed.
