# Azure Deployment Environment Configuration
# Copy this file to .env.azure and configure for your Azure environment

# Backend Configuration
BACKEND_PORT=3000
RUST_LOG=info

# Frontend Configuration
FRONTEND_PORT=80

# API URL - Update this to your Azure Container Instances public DNS name
# Format: http://<your-container-group-name>.<region>.azurecontainer.io:3000
# Example: http://chess-rust-prod.eastus.azurecontainer.io:3000
API_URL=http://localhost:3000

# Azure Container Instances Configuration (for reference)
# RESOURCE_GROUP=chess-rust-rg
# CONTAINER_GROUP_NAME=chess-rust-prod
# LOCATION=eastus
# DNS_NAME_LABEL=chess-rust-prod
