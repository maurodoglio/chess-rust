# Example environment variables for Render deployment
# These can be set in the Render dashboard for each service

# Backend Service Environment Variables
# =======================================
# PORT is automatically set by Render (typically 10000)
# You don't need to set this manually

# Logging level (options: trace, debug, info, warn, error)
RUST_LOG=info

# Frontend Service Environment Variables  
# =======================================
# API_URL is automatically set from the backend service URL
# when using render.yaml's fromService configuration
# You only need to set this manually if deploying services separately

# Example manual configuration:
# API_URL=https://chess-rust-backend.onrender.com

# Notes:
# - Set environment variables in Render Dashboard under Service Settings > Environment
# - Changes to environment variables will trigger a redeploy
# - For security, never commit actual secrets to version control
